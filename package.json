{
  "name": "focus-clock",
  "version": "1.0.0",
  "description": "適合升大學專題展示的自律番茄鐘桌面程式",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/logic.test.js",
    "dist:win": "electron-builder --win portable",
    "build:web": "node scripts/build-web.js",
    "android:add": "npm run build:web && node scripts/run-capacitor.js add android",
    "android:sync": "npm run build:web && node scripts/run-capacitor.js sync android && node scripts/sync-android-icon.js",
    "android:apk": "npm run android:sync && node scripts/build-android.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "tw.student.focusclock",
    "productName": "Focus Clock",
    "artifactName": "FocusClock-${version}-Windows.${ext}",
    "files": [
      "main.js",
      "logic.js",
      "preload.js",
      "focus-preload.js",
      "focus-web-preload.js",
      "web-adapter.js",
      "manifest.json",
      "service-worker.js",
      "pwa-icon-192.png",
      "pwa-icon-512.png",
      "index.html",
      "styles.css",
      "renderer.js",
      "focus.html",
      "focus.css",
      "focus.js",
      "icon.png",
      "icon-256.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon-256.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  }
}
